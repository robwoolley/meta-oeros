#
# Helper for firmware recipes that ship a per-overlay
# /usr/lib/modules-load.d/<FW_NAME>.conf module-load list.
#
# Each consumer recipe sets:
#   FW_NAME              - the firmware basename (e.g. kd240-bist)
#   KRIA_FW_MODULES      - newline- or space-separated list of kernel
#                          module basenames (without the .ko suffix)
#                          to load when this firmware is activated.
#
# The conf file follows systemd-modules-load.d(5) syntax (one module
# per line, '#' comments). The standalone kria-modules-load helper
# in recipes-utils/kria-modules-load reads the same file at runtime
# inside the OCI containers (where systemd is not running).

install_kria_fw_modules_load_conf() {
    if [ -z "${KRIA_FW_MODULES}" ]; then
        return 0
    fi
    install -d ${D}${nonarch_base_libdir}/modules-load.d
    {
        echo "# Auto-generated by ${PN} - kernel modules required by the"
        echo "# ${FW_NAME} DT overlay. Loaded by kria-modules-load(1)"
        echo "# (or systemd-modules-load.service on systemd hosts)."
        for m in ${KRIA_FW_MODULES}; do
            echo "$m"
        done
    } > ${D}${nonarch_base_libdir}/modules-load.d/${FW_NAME}.conf
    chmod 0644 ${D}${nonarch_base_libdir}/modules-load.d/${FW_NAME}.conf
}

do_install[postfuncs] += "install_kria_fw_modules_load_conf"

FILES:${PN} += "${nonarch_base_libdir}/modules-load.d/${FW_NAME}.conf"
