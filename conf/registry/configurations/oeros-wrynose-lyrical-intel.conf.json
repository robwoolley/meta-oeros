{
    "description": "OpenEmbedded ROS - Wrynose Lyrical (Intel Core Ultra/Atom Edge AI). The Robotics AI Suite variant is the separate oeros-wrynose-jazzy config. See docs/edgeai.md.",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "2.18",
                "rev": "2.18"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-clang": {
            "git-remote": {
                "uri": "https://github.com/kraj/meta-clang.git",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-intel-realsense": {
            "git-remote": {
                "uri": "https://github.com/realsenseai/meta-intel-realsense.git",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-oeros": {
            "git-remote": {
                "uri": "https://github.com/robwoolley/meta-oeros",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-tensorflow-lite": {
            "git-remote": {
                "uri": "https://github.com/robwoolley/meta-tensorflow-lite",
                "branch": "feature/wrynose-upstream-main",
                "rev": "feature/wrynose-upstream-main"
            }
        },
        "meta-onnxruntime": {
            "git-remote": {
                "uri": "https://github.com/robwoolley/meta-onnxruntime",
                "branch": "feature/wrynose-upstream-main",
                "rev": "feature/wrynose-upstream-main"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://github.com/openembedded/meta-openembedded",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-python-ai": {
            "git-remote": {
                "uri": "https://github.com/zboszor/meta-python-ai",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-qt6": {
            "git-remote": {
                "uri": "https://code.qt.io/yocto/meta-qt6.git",
                "branch": "6.11",
                "rev": "6.11"
            }
        },
        "meta-ros": {
            "git-remote": {
                "uri": "https://github.com/ros/meta-ros.git",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-virtualization": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-virtualization",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-security": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-security",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-zenoh": {
            "git-remote": {
                "uri": "https://github.com/Jarsop/meta-zenoh.git",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-intel": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-intel",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-openvino": {
            "git-remote": {
                "uri": "https://github.com/intel/meta-openvino",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-clang-revival": {
            "git-remote": {
                "uri": "https://github.com/zboszor/meta-clang-revival",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "name": "oeros-wrynose-lyrical-intel",
                "description": "OpenEmbedded ROS Wrynose Lyrical -- Intel Edge AI",
                "setup-dir-name": "oeros-wrynose-lyrical-intel",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-openembedded/meta-filesystems",
                    "meta-openembedded/meta-gnome",
                    "meta-openembedded/meta-initramfs",
                    "meta-openembedded/meta-multimedia",
                    "meta-openembedded/meta-networking",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-perl",
                    "meta-openembedded/meta-python",
                    "meta-openembedded/meta-webserver",
                    "meta-openembedded/meta-xfce",
                    "meta-clang",
                    "meta-intel-realsense",
                    "meta-oeros",
                    "meta-tensorflow-lite",
                    "meta-onnxruntime",
                    "meta-clang-revival",
                    "meta-intel",
                    "meta-openvino",
                    "meta-python-ai",
                    "meta-qt6",
                    "meta-ros/meta-ros-common",
                    "meta-ros/meta-ros2",
                    "meta-ros/meta-ros2-lyrical",
                    "meta-virtualization",
                    "meta-security",
                    "meta-security/meta-tpm",
                    "meta-zenoh/meta-zenoh"
                ],
                "bb-env-passthrough-additions": ["DL_DIR", "SSTATE_DIR"],
                "oe-fragments-one-of": {
                    "distro": {
                        "description": "Target distributions",
                        "options" : [
                            { "name": "distro/oeros", "description": "Oeros Reference Distro" }
                        ]
                    },
                    "machine": {
                        "description": "Target machines",
                        "options" : [
                            { "name": "machine/genericx86-64", "description": "Machine configuration for generic x86_64 (64-bit) PCs and servers" },
                            { "name": "oeros/machine-intel-corei7-64", "description": "Edge AI: Intel Core Ultra/Atom -- OpenVINO on CPU/iGPU/NPU" }
                        ]
                    }
                }
            }
        ]
    },
    "version": "1.0"
}
