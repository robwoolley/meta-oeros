    "bitbake-setup": {
        "configurations": [
            {
                "name": "oeros-wrynose-lyrical",
                "description": "OpenEmbedded ROS Wrynose Lyrical",
                "setup-dir-name": "oeros-wrynose-lyrical",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-openembedded/meta-filesystems",
                    "meta-openembedded/meta-gnome",
                    "meta-openembedded/meta-initramfs",
                    "meta-openembedded/meta-multimedia",
                    "meta-openembedded/meta-networking",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-perl",
                    "meta-openembedded/meta-python",
                    "meta-openembedded/meta-webserver",
                    "meta-openembedded/meta-xfce",
                    "meta-clang",
                    "meta-intel-realsense",
                    "meta-oeros",
                    "meta-tensorflow-lite",
                    "meta-onnxruntime",
                    "meta-tegra",
                    "meta-freescale",
                    "meta-imx/meta-imx-bsp",
                    "meta-imx/meta-imx-sdk",
                    "meta-imx/meta-imx-ml",
                    "meta-qcom",
                    "meta-qcom-distro",
                    "meta-ti/meta-ti-bsp",
                    "meta-ti/meta-ti-extras",
                    "meta-arm/meta-arm",
                    "meta-arm/meta-arm-toolchain",
                    "meta-edgeai",
                    "meta-intel",
                    "meta-openvino",
                    "meta-python-ai",
                    "meta-qt6",
                    "meta-raspberrypi",
                    "meta-ros/meta-ros-common",
                    "meta-ros/meta-ros2",
                    "meta-ros/meta-ros2-lyrical",
                    "meta-virtualization",
                    "meta-zenoh/meta-zenoh"
                ],
                "bb-env-passthrough-additions": ["DL_DIR","SSTATE_DIR","NVIDIA_DEVNET_MIRROR"],
                "oe-fragments-one-of": {
                    "distro": {
                        "description": "Target distributions",
                        "options" : [
                            { "name": "distro/oeros", "description": "Oeros Reference Distro" }
                        ]
                    },
                    "machine": {
                        "description": "Target machines",
                        "options" : [
                            { "name": "machine/qemux86-64", "description": "Machine configuration for running an x86-64 system on QEMU" },
                            { "name": "machine/qemuarm64", "description": "Machine configuration for running an ARMv8 system on QEMU" },
                            { "name": "machine/qemuriscv64", "description": "Machine configuration for running an RISC-V system on QEMU" },
                            { "name": "machine/genericarm64", "description": "Machine configuration for Arm64 SystemReady IR/ES platforms" },
                            { "name": "machine/genericx86-64", "description": "Machine configuration for generic x86_64 (64-bit) PCs and servers" },
                            { "name": "machine/raspberrypi0-2w-64", "description": "Machine configuration for Raspberry Pi Zero 2W (64-bit)" },
                            { "name": "machine/raspberrypi4-64", "description": "Machine configuration for Raspberry Pi 4 (64-bit)" },
                            { "name": "machine/raspberrypi5", "description": "Machine configuration for Raspberry Pi 5" },

                            { "name": "oeros/machine-jetson-orin-nano-devkit-super", "description": "Edge AI: Nvidia Jetson Orin Nano Super -- CUDA/TensorRT/VPI, Isaac ROS" },
                            { "name": "oeros/machine-jetson-agx-orin-devkit", "description": "Edge AI: Nvidia Jetson AGX Orin -- CUDA/TensorRT/VPI, Isaac ROS" },
                            { "name": "oeros/machine-imx8mp-lpddr4-evk", "description": "Edge AI: NXP i.MX 8M Plus -- eIQ, VX delegate on the Vivante NPU" },
                            { "name": "oeros/machine-imx93-11x11-lpddr4x-evk", "description": "Edge AI: NXP i.MX 93 -- eIQ, Ethos-U NPU delegate" },
                            { "name": "oeros/machine-imx95-19x19-lpddr5-evk", "description": "Edge AI: NXP i.MX 95 -- eIQ, Neutron NPU delegate" },
                            { "name": "oeros/machine-qcs6490-rb3gen2-core-kit", "description": "Edge AI: Qualcomm RB3 Gen 2 -- QAIRT/QNN on Hexagon (QIM GStreamer/ROS pipeline pending vendor wrynose support)" },
                            { "name": "oeros/machine-qcs9100-ride-sx", "description": "Edge AI: Qualcomm QCS9100 Ride SX -- QAIRT/QNN on Hexagon (QIM GStreamer/ROS pipeline pending vendor wrynose support)" },
                            { "name": "oeros/machine-am62axx-evk", "description": "Edge AI: TI AM62A -- TIDL on C7x/MMA, Edge AI GStreamer, robotics kit" },
                            { "name": "oeros/machine-am68-sk", "description": "Edge AI: TI AM68 -- TIDL on C7x/MMA, Edge AI GStreamer, robotics kit" },
                            { "name": "oeros/machine-am69-sk", "description": "Edge AI: TI AM69 -- TIDL on C7x/MMA, Edge AI GStreamer, robotics kit" },
                            { "name": "oeros/machine-intel-corei7-64", "description": "Edge AI: Intel Core Ultra/Atom -- OpenVINO on CPU/iGPU/NPU" }
                        ]
                    }
                }
            }
        ]
    },
    "version": "1.0"
}
