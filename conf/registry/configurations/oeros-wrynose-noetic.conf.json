{
    "description": "OpenEmbedded ROS - Wrynose Noetic",
    "sources": {
        "meta-clang": {
            "git-remote": {
                "uri": "https://github.com/kraj/meta-clang.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-clang-revival": {
            "git-remote": {
                "uri": "https://github.com/zboszor/meta-clang-revival",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://github.com/openembedded/meta-openembedded.git",
                "branch": "master",
                "rev": "100027977216601000cbefc42c2ff6cf667e7b5e"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-yocto",
                "branch": "master",
                "rev": "8251bdad5fda780a000fb41e6eda82eadf0fa39e"
            }
        },
        "meta-oeros": {
            "git-remote": {
                "uri": "https://github.com/robwoolley/meta-oeros.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://github.com/openembedded/openembedded-core.git",
                "branch": "master",
                "rev": "06dd66e6220e5ce4ed4b9af4d8231ae5f0a8ce80"
            }
        },
        "meta-python-ai": {
            "git-remote": {
                "uri": "https://github.com/zboszor/meta-python-ai",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-qt5": {
            "git-remote": {
                "uri": "https://github.com/meta-qt5/meta-qt5.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-raspberrypi": {
            "git-remote": {
                "uri": "https://github.com/agherzan/meta-raspberrypi.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-intel-realsense": {
            "git-remote": {
                "uri": "https://github.com/realsenseai/meta-intel-realsense.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-ros": {
            "git-remote": {
                "uri": "https://github.com/ros/meta-ros.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-virtualization": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-virtualization",
                "branch": "master",
                "rev": "master"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "name": "oeros-wrynose-noetic",
                "description": "OpenEmbedded ROS Wrynose Noetic",
                "setup-dir-name": "oeros-wrynose-noetic",
                "bb-layers": [
                    "meta-clang",
                    "meta-clang-revival",
                    "meta-openembedded/meta-filesystems",
                    "meta-openembedded/meta-gnome",
                    "meta-openembedded/meta-initramfs",
                    "meta-openembedded/meta-multimedia",
                    "meta-openembedded/meta-networking",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-perl",
                    "meta-openembedded/meta-python",
                    "meta-openembedded/meta-webserver",
                    "meta-openembedded/meta-xfce",
                    "meta-yocto/meta-poky",
                    "meta-yocto/meta-yocto-bsp",
                    "meta-oeros",
                    "openembedded-core/meta",
                    "meta-python-ai",
                    "meta-qt5",
                    "meta-raspberrypi",
                    "meta-intel-realsense",
                    "meta-ros/meta-ros-common",
                    "meta-ros/meta-ros1",
                    "meta-ros/meta-ros1-noetic",
                    "meta-virtualization"
                ],
                "bb-env-passthrough-additions": [
                    "DL_DIR",
                    "SSTATE_DIR"
                ],
                "oe-fragments": [
                    "distro/oeros",
                    "oeros/common",
                    "oeros/qa/allow-license-exists",
                    "oeros/allow-commercial-licenses"
                ],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machines",
                        "options": [
                            {
                                "name": "machine/raspberrypi5",
                                "description": "Machine configuration for Raspberry Pi 5"
                            }
                        ]
                    }
                }
            }
        ]
    },
    "version": "1.0"
}
