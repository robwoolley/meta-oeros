{
    "description": "OpenEmbedded ROS - Master Jazzy",
    "sources": {
        "meta-clang": {
            "git-remote": {
                "uri": "https://github.com/kraj/meta-clang.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://github.com/openembedded/meta-openembedded.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-oeros": {
            "git-remote": {
                "uri": "https://github.com/robwoolley/meta-oeros.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://github.com/openembedded/openembedded-core.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-python-ai": {
            "git-remote": {
                "uri": "https://github.com/zboszor/meta-python-ai",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-qt5": {
            "git-remote": {
                "uri": "https://github.com/meta-qt5/meta-qt5.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-intel-realsense": {
            "git-remote": {
                "uri": "https://github.com/realsenseai/meta-intel-realsense.git",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-ros": {
            "git-remote": {
                "uri": "https://github.com/ros/meta-ros.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-virtualization": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-virtualization",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-zenoh": {
            "git-remote": {
                "uri": "https://github.com/Jarsop/meta-zenoh.git",
                "branch": "master",
                "rev": "master"
            }
        },
        "meta-raspberrypi": {
            "git-remote": {
                "uri": "https://github.com/agherzan/meta-raspberrypi.git",
                "branch": "master",
                "rev": "master"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "name": "oeros-master-jazzy",
                "description": "OpenEmbedded ROS Master Jazzy",
                "setup-dir-name": "oeros-master-jazzy",
                "bb-layers": [
                    "meta-clang",
                    "meta-openembedded/meta-filesystems",
                    "meta-openembedded/meta-gnome",
                    "meta-openembedded/meta-initramfs",
                    "meta-openembedded/meta-multimedia",
                    "meta-openembedded/meta-networking",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-perl",
                    "meta-openembedded/meta-python",
                    "meta-openembedded/meta-webserver",
                    "meta-openembedded/meta-xfce",
                    "meta-oeros",
                    "openembedded-core/meta",
                    "meta-python-ai",
                    "meta-qt5",
                    "meta-intel-realsense",
                    "meta-ros/meta-ros-common",
                    "meta-ros/meta-ros2",
                    "meta-ros/meta-ros2-jazzy",
                    "meta-virtualization",
                    "meta-zenoh/meta-zenoh",
                    "meta-raspberrypi"
                ],
                "bb-env-passthrough-additions": [
                    "DL_DIR",
                    "SSTATE_DIR"
                ],
                "oe-fragments": [
                    "distro/oeros",
                    "oeros/common",
                    "oeros/qa/allow-license-format",
                    "oeros/allow-commercial-licenses"
                ],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machines",
                        "options": [
                            {
                                "name": "machine/qemux86-64",
                                "description": "Machine configuration for running an x86-64 system on QEMU"
                            },
                            {
                                "name": "machine/raspberrypi4-64",
                                "description": "Machine configuration for Raspberry Pi 4 (64-bit)"
                            },
                            {
                                "name": "machine/raspberrypi5",
                                "description": "Machine configuration for Raspberry Pi 5"
                            }
                        ]
                    }
                }
            }
        ]
    },
    "version": "1.0"
}
