    "bitbake-setup": {
        "configurations": [
            {
                "name": "oeros-wrynose-lyrical-amd",
                "description": "OpenEmbedded ROS Wrynose Lyrical -- AMD/Xilinx Kria + Versal Edge AI",
                "setup-dir-name": "oeros-wrynose-lyrical-amd",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-openembedded/meta-filesystems",
                    "meta-openembedded/meta-multimedia",
                    "meta-openembedded/meta-networking",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-perl",
                    "meta-openembedded/meta-python",
                    "meta-clang",
                    "meta-intel-realsense",
                    "meta-oeros",
                    "meta-tensorflow-lite",
                    "meta-onnxruntime",
                    "meta-arm/meta-arm",
                    "meta-arm/meta-arm-toolchain",
                    "meta-xilinx/meta-microblaze",
                    "meta-xilinx/meta-xilinx-core",
                    "meta-xilinx/meta-xilinx-standalone",
                    "meta-xilinx/meta-xilinx-standalone-sdt",
                    "meta-xilinx/meta-xilinx-multimedia",
                    "meta-xilinx/meta-xilinx-mali400",
                    "meta-xilinx/meta-xilinx-gpu-malig78ae",
                    "meta-kria/meta-kria-core",
                    "meta-kria/meta-kria-bsp",
                    "meta-amd-adaptive-socs/meta-amd-adaptive-socs-core",
                    "meta-amd-adaptive-socs/meta-amd-adaptive-socs-bsp",
                    "meta-vitis",
                    "meta-openamp",
                    "meta-xilinx-tsn",
                    "meta-jupyter",
                    "meta-python-ai",
                    "meta-qt6",
                    "meta-ros/meta-ros-common",
                    "meta-ros/meta-ros2",
                    "meta-ros/meta-ros2-lyrical",
                    "meta-virtualization",
                    "meta-zenoh/meta-zenoh"
                ],
                "bb-env-passthrough-additions": [
                    "DL_DIR",
                    "SSTATE_DIR"
                ],
                "oe-fragments-one-of": {
                    "distro": {
                        "description": "Target distributions",
                        "options": [
                            {
                                "name": "distro/oeros",
                                "description": "Oeros Reference Distro"
                            }
                        ]
                    },
                    "machine": {
                        "description": "Target machines",
                        "options": [
                            {
                                "name": "machine/qemuarm64",
                                "description": "Machine configuration for running an ARMv8 system on QEMU"
                            },
                            {
                                "name": "oeros/machine-k26-smk-kr-sdt",
                                "description": "Edge AI + robotics: AMD Kria KR260 Robotics Starter Kit (K26 SOM, Zynq UltraScale+ EV) -- XRT/DFX accelerators, ros2_control, TSN"
                            },
                            {
                                "name": "oeros/machine-k26-smk-kv-sdt",
                                "description": "Edge AI: AMD Kria KV260 Vision AI Starter Kit (K26 SOM) -- XRT/DFX accelerators, camera pipelines (VCU with oeros/amd-proprietary)"
                            },
                            {
                                "name": "oeros/machine-k24-smk-kd-sdt",
                                "description": "Robotics/industrial: AMD Kria KD240 Drives Starter Kit (K24 SOM) -- motor control, ros2_control, CAN/TSN"
                            },
                            {
                                "name": "oeros/machine-versal-vek280-sdt-seg",
                                "description": "Edge AI: AMD Versal AI Edge VEK280 -- AIE-ML array, XRT (Vitis AI runtime not yet on wrynose)"
                            },
                            {
                                "name": "oeros/machine-versal-2ve-2vm-vek385-revb-sdt-seg",
                                "description": "Edge AI: AMD Versal AI Edge Gen 2 VEK385 Rev B -- AIE-MLv2 array, XRT (Vitis AI runtime not yet on wrynose)"
                            }
                        ]
                    }
                }
            }
        ]
    },
    "version": "1.0"
}
